// benchmark/spirits_within/lip_sync.frontier
// Voice-Driven Phoneme → FACS Lip Sync — Spirits Within Benchmark
// Project Nexus · ARC A+ Hard Gate

component LipSyncSystem {
    static phonemeMap: {
        "AA": { mouthOpen: 0.8, mouthPucker: 0.0 },
        "AE": { mouthOpen: 0.6, mouthPucker: 0.0 },
        "AH": { mouthOpen: 0.7, mouthPucker: 0.0 },
        "AO": { mouthOpen: 0.75, mouthPucker: 0.1 },
        "AW": { mouthOpen: 0.7, mouthPucker: 0.2 },
        "AY": { mouthOpen: 0.65, mouthPucker: 0.0 },
        "B":  { mouthOpen: 0.2, mouthPucker: 0.8 },
        "CH": { mouthOpen: 0.3, mouthPucker: 0.6 },
        "D":  { mouthOpen: 0.2, mouthPucker: 0.7 },
        "DH": { mouthOpen: 0.25, mouthPucker: 0.5 },
        "EH": { mouthOpen: 0.55, mouthPucker: 0.0 },
        "ER": { mouthOpen: 0.4, mouthPucker: 0.3 },
        "EY": { mouthOpen: 0.5, mouthPucker: 0.0 },
        "F":  { mouthOpen: 0.1, mouthPucker: 0.9 },
        "G":  { mouthOpen: 0.2, mouthPucker: 0.7 },
        "HH": { mouthOpen: 0.4, mouthPucker: 0.2 },
        "IH": { mouthOpen: 0.35, mouthPucker: 0.1 },
        "IY": { mouthOpen: 0.3, mouthPucker: 0.2 },
        "JH": { mouthOpen: 0.25, mouthPucker: 0.65 },
        "K":  { mouthOpen: 0.2, mouthPucker: 0.7 },
        "L":  { mouthOpen: 0.3, mouthPucker: 0.6 },
        "M":  { mouthOpen: 0.1, mouthPucker: 0.9 },
        "N":  { mouthOpen: 0.2, mouthPucker: 0.8 },
        "NG": { mouthOpen: 0.2, mouthPucker: 0.75 },
        "OW": { mouthOpen: 0.6, mouthPucker: 0.4 },
        "OY": { mouthOpen: 0.55, mouthPucker: 0.35 },
        "P":  { mouthOpen: 0.1, mouthPucker: 0.9 },
        "R":  { mouthOpen: 0.3, mouthPucker: 0.5 },
        "S":  { mouthOpen: 0.1, mouthPucker: 0.8 },
        "SH": { mouthOpen: 0.2, mouthPucker: 0.7 },
        "T":  { mouthOpen: 0.2, mouthPucker: 0.8 },
        "TH": { mouthOpen: 0.2, mouthPucker: 0.5 },
        "UH": { mouthOpen: 0.45, mouthPucker: 0.3 },
        "UW": { mouthOpen: 0.4, mouthPucker: 0.6 },
        "V":  { mouthOpen: 0.1, mouthPucker: 0.9 },
        "W":  { mouthOpen: 0.2, mouthPucker: 0.8 },
        "Y":  { mouthOpen: 0.3, mouthPucker: 0.6 },
        "Z":  { mouthOpen: 0.1, mouthPucker: 0.8 },
        "ZH": { mouthOpen: 0.15, mouthPucker: 0.75 },
    },

    static generateLipSync(audio: AudioStream) -> FACSMap {
        let start = time;

        let phonemes = AIEngine.speechToPhonemes(audio);
        let facs = FACSMap.neutral();

        for phoneme in phonemes {
            let target = LipSyncSystem.phonemeMap[phoneme.phoneme];
            let t = phoneme.timestamp;
            facs = FacialSystem.blendExpressions(facs, target, t);
        }

        // ARC Gate: Lip sync < 1ms
        assert((time - start) < 1.0);

        return facs;
    },

    static accuracy(reference: AudioStream, generated: FACSMap) -> f32 {
        return LipSyncEvaluator.compare(reference, generated);
    }
}
